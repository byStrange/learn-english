{
  "name": "learn-english",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:readme": "bash scripts/check-readme-example.sh",
    "audio": "npm --prefix tools/tts run make --",
    "audio:samples": "npm --prefix tools/tts run samples",
    "set-pin": "node scripts/set-pin.mjs",
    "build:demo": "tsc -b && vite build --mode demo --outDir dist-demo"
  },
  "dependencies": {
    "@curialy/ui": "file:vendor/curialy/curialy-ui-0.7.16.tgz",
    "@curialy/ui-theme-butter": "file:vendor/curialy/curialy-ui-theme-butter-0.7.16.tgz",
    "@heroicons/react": "2.2.0",
    "@stylexjs/stylex": "0.19.2",
    "@supabase/supabase-js": "2.119.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.6",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "26.1.0",
    "typescript": "5.8.3",
    "vite": "6.4.6",
    "vitest": "3.2.4"
  }
}
